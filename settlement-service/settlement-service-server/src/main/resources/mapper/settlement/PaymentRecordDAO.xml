<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.volunteer.platform.settlement.dao.PaymentRecordDAO">

  <resultMap id="PaymentRecordResultMap" type="com.volunteer.platform.settlement.entity.PaymentRecordDO">
    <id column="id" property="id"/>
    <result column="bill_id" property="billId"/>
    <result column="pay_no" property="payNo"/>
    <result column="pay_channel" property="payChannel"/>
    <result column="pay_amount" property="payAmount"/>
    <result column="pay_status" property="payStatus"/>
    <result column="pay_time" property="payTime"/>
  </resultMap>

  <insert id="insert" parameterType="com.volunteer.platform.settlement.entity.PaymentRecordDO"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO payment_record (
      bill_id,
      pay_no,
      pay_channel,
      pay_amount,
      pay_status,
      pay_time
    ) VALUES (
      #{billId},
      #{payNo},
      #{payChannel},
      #{payAmount},
      #{payStatus},
      #{payTime}
    )
  </insert>

  <select id="selectByBillId" resultMap="PaymentRecordResultMap">
    SELECT
      id,
      bill_id,
      pay_no,
      pay_channel,
      pay_amount,
      pay_status,
      pay_time
    FROM payment_record
    WHERE bill_id = #{billId}
      AND is_deleted = 0
    ORDER BY id ASC
  </select>
</mapper>
